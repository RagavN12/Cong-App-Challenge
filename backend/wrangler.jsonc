{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ecoai-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-03-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecoai-friends",
      "database_id": "00000000000000000000000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Non-secret Auth0 tenant info, used to verify the JWT the Mac app sends.
    // Matches EcoAI/Auth0.plist — update both together if you change tenants.
    "AUTH0_DOMAIN": "dev-bg7lc3xvb0dth1f2.us.auth0.com",
    "AUTH0_AUDIENCE": "https://api.ecoai.app"
  }
  // Secrets (never put these here — set them with `wrangler secret put <NAME>`):
  //   OPENROUTER_API_KEY
}